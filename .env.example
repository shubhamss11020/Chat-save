# ---- Capture agent (your PC) ----
# Name used for the folder under raw_queries/
# CHATSAVE_USER=shubham

# ---- Shared token: the server requires it, the agent sends it ----
MCP_AUTH_TOKEN=

# ---- Git target: set on whichever side writes Git (the MCP server, or the agent if
# Empty = commit locally, no push. ----
CHATSAVE_GIT_URL=
CHATSAVE_GIT_BRANCH=main

# ---- S3 / Object Storage (for Images, PDFs, Videos, & Attachments) ----
# AWS S3 (Active):
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 / Custom S3 Endpoint (Optional - switch to R2 later):
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_PREFIX=https://cdn.yourdomain.com
# S3_PRESIGN_EXPIRATION=3600


# ---- Access control (server) ----
# With no MCP_AUTH_TOKEN / USER_TOKENS the server refuses all requests. Only set this to 1
# for local development on a machine you control.
# CHATSAVE_ALLOW_OPEN=0
# Browser origins allowed to call the API directly (comma-separated). Empty = none.
# CHATSAVE_CORS_ORIGINS=
# Users who may search/read every person's transcripts over MCP (comma-separated).
# CHATSAVE_ADMIN_USERS=

# ---- Per-person tokens (one per teammate) ----
# Format: name:token,name:token  (names: lowercase letters, digits, - or _; no spaces)
# Generate each token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the REAL values only in Render's Environment tab (mark as secret), never in this file.
# Example shape (fake values):
# USER_TOKENS=alex:REPLACE_WITH_TOKEN_1,bob:REPLACE_WITH_TOKEN_2


# ---- PostgreSQL database (required for the live server) ----
# Paste the pooled connection address from Neon or Render's Postgres page.
# Leave empty to use the local SQLite file (fine for testing on your PC only).
# In production, set this in Render's Environment tab (secret), never in this file.
# Example shape (fake): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CHATSAVE_DATABASE_URL=
