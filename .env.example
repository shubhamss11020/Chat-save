# GitHub repo that receives every saved chat (keep it PRIVATE)
# Local:  https://github.com/<you>/<repo>.git   (uses your stored git credentials)
# Render: https://<github-token>@github.com/<you>/<repo>.git
CHATSAVE_GIT_URL=
CHATSAVE_GIT_BRANCH=main
# Name used for the folder under raw_queries/
# CHATSAVE_USER=shubham

# Require this token on /mcp and the API (Bearer header or ?key=). Empty = open.
MCP_AUTH_TOKEN=
